# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# Supabase Auth (required for login — never commit real values)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Development Settings
VITE_DEV_MODE=true
VITE_LOG_LEVEL=debug

# Production (set these in the Render/GitHub secrets, not in this file)
# Vite embeds VITE_* values at build time. After changing them, redeploy.
# VITE_API_BASE_URL=https://your-fastapi-service.onrender.com
# VITE_API_TIMEOUT=120000
# VITE_API_RETRY_ATTEMPTS=3
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# GitHub Actions secrets: VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY (anon only — never service_role)
